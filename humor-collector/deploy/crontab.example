# crontab -e   (adjust the path; logs also go to data/logs/collector.log)
# recent popular posts every 3 hours
17 */3 * * *  /opt/humor-collector/deploy/run_collect.sh >> /opt/humor-collector/data/logs/cron.log 2>&1
# past popular posts once a day (continues where the previous run stopped)
43 4 * * *    /opt/humor-collector/deploy/run_collect.sh --mode archive >> /opt/humor-collector/data/logs/cron.log 2>&1
# refresh numbers of posts from the last 3 days that dropped off the lists
29 5 * * *    cd /opt/humor-collector && .venv/bin/python main.py refresh --source ruliweb && .venv/bin/python main.py refresh --source bobaedream
# Bluesky: delete posts removed at the source / authors who opted out since (developer guidelines)
47 5 * * *    cd /opt/humor-collector && .venv/bin/python main.py refresh --source bluesky --max-age-days 3650 --limit 1000
# optional: daily YouTube lookup for meme keywords (needs YOUTUBE_API_KEY in the cron environment)
# 7 6 * * *   cd /opt/humor-collector && YOUTUBE_API_KEY=... .venv/bin/python main.py youtube popular
